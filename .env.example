# This release is an explicitly labelled local demonstration. No production calls.
VITE_PATIENT_MODE=demo

# Optional live collector integration, supplied by the hospital's patient BFF.
# Leave blank for the local guided demo. Never put JWTs or API keys here.
VITE_SYMPTOM_COLLECTOR_SESSION_ENDPOINT=
VITE_SYMPTOM_COLLECTOR_ORIGIN=
VITE_PATIENT_AGENT_ORIGIN=

# "Add symptoms" target: unset/"mock" = placeholder mirroring the hosted
# collector (default); a URL = the hosted collector (patient signs in by OTP),
# e.g. https://pm-agents-pwa-uat.tatvacare.in/symptoms-collector ; "off" = local demo.
VITE_SYMPTOM_COLLECTOR_URL=mock
